# pyenv
#   For a library or app, you might want to share this in the project to
#   specify the python version. But if you want to ignore it:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing pipenv install --ignore-pipfile, you should keep it.
#   Pipfile.lock

# poetry
#   According to poetry documentation, poetry.lock should be committed.
#   poetry.lock

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# pdm
#   https://pdm.fming.dev/latest/usage/project/#commit-the-lockfile-or-not
.pdm-python
.pdm-build/

# pipx
.pipx/

# uv
#   According to uv documentation, uv.lock should be committed for applications but maybe ignored for libraries.
#   Since this looks like an application, we don't ignore uv.lock.

# environments
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# virtual environments
.venv/
venv/
ENV/
env/

