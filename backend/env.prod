# Application Environment
ENVIRONMENT=production

# OpenAI LLM slot configuration (Default)
FACTORY_LLM_DEFAULT_PROVIDER=openai
FACTORY_LLM_DEFAULT_MODEL=gpt-5.4-nano
# FACTORY_LLM_DEFAULT_API_KEY=

# Optional fallback slots
FACTORY_LLM_FALLBACK1_PROVIDER=none
FACTORY_LLM_FALLBACK2_PROVIDER=none

FACTORY_LLM_TIMEOUT_MS=20000
FACTORY_LLM_MAX_OUTPUT_TOKENS=2048
FACTORY_LLM_TEMPERATURE=0.2

# Provider API keys
# OPENAI_API_KEY=

# Smoke test runner
FACTORY_SMOKE_BASE_URL=http://127.0.0.1:18000
FACTORY_SMOKE_WS_PATH=/ws/agent
