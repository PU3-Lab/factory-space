# Application Environment
# ENVIRONMENT=development
# ENVIRONMENT=production

# LLM slot configuration
# Dev mode uses local LLM as the default slot.
FACTORY_LLM_DEFAULT_PROVIDER=local
FACTORY_LLM_DEFAULT_MODEL=llama3.1:8b
FACTORY_LLM_DEFAULT_BASE_URL=http://localhost:11434/v1
# FACTORY_LLM_DEFAULT_API_KEY=

# Optional fallback slots. Leave as none for local development without remote APIs.
FACTORY_LLM_FALLBACK1_PROVIDER=none
# FACTORY_LLM_FALLBACK1_MODEL=
# FACTORY_LLM_FALLBACK1_BASE_URL=
# FACTORY_LLM_FALLBACK1_API_KEY=

FACTORY_LLM_FALLBACK2_PROVIDER=none
# FACTORY_LLM_FALLBACK2_MODEL=
# FACTORY_LLM_FALLBACK2_BASE_URL=
# FACTORY_LLM_FALLBACK2_API_KEY=

FACTORY_LLM_TIMEOUT_MS=20000
FACTORY_LLM_MAX_OUTPUT_TOKENS=2048
FACTORY_LLM_TEMPERATURE=0.2

# Provider API keys
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Database Configuration
# RAG ingestion requires PostgreSQL + pgvector.
# Start local pgvector with:
# docker compose -f docker-compose.rag.yml up -d
# FACTORY_DATABASE_URL=postgresql+psycopg://factory_space:factory_space@127.0.0.1:5433/factory_space?connect_timeout=5

# RAG embedding configuration
# FACTORY_EMBEDDING_PROVIDER=openai
# FACTORY_EMBEDDING_MODEL=text-embedding-3-small
# FACTORY_EMBEDDING_DIMENSIONS=1536
# FACTORY_EMBEDDING_API_KEY=
#
# Local embedding example for Ollama native embedding.
# Use this when you want embeddings to be generated by a local model server.
# FACTORY_EMBEDDING_PROVIDER=local
# FACTORY_EMBEDDING_MODEL=nomic-embed-text
# FACTORY_EMBEDDING_DIMENSIONS=768
# FACTORY_EMBEDDING_BASE_URL=http://localhost:11434

# Logging
# LOG_LEVEL=INFO

# Smoke test runner
FACTORY_SMOKE_BASE_URL=http://127.0.0.1:18000
FACTORY_SMOKE_WS_PATH=/ws/agent
# FACTORY_SMOKE_EXTERNAL_PROVIDER=1
