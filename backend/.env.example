# Application Environment
# ENVIRONMENT=development
# ENVIRONMENT=production

# LLM slot configuration
# Dev mode uses local LLM as the default slot.
FACTORY_LLM_DEFAULT_PROVIDER=local
FACTORY_LLM_DEFAULT_MODEL=llama3.1:8b
FACTORY_LLM_DEFAULT_BASE_URL=http://localhost:11434/v1
# FACTORY_LLM_DEFAULT_API_KEY=

# Optional fallback slots. Leave as none for local development without remote APIs.
FACTORY_LLM_FALLBACK1_PROVIDER=none
# FACTORY_LLM_FALLBACK1_MODEL=
# FACTORY_LLM_FALLBACK1_BASE_URL=
# FACTORY_LLM_FALLBACK1_API_KEY=

FACTORY_LLM_FALLBACK2_PROVIDER=none
# FACTORY_LLM_FALLBACK2_MODEL=
# FACTORY_LLM_FALLBACK2_BASE_URL=
# FACTORY_LLM_FALLBACK2_API_KEY=

FACTORY_LLM_TIMEOUT_MS=20000
FACTORY_LLM_MAX_OUTPUT_TOKENS=2048
FACTORY_LLM_TEMPERATURE=0.2

# Provider API keys
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Database Configuration (Optional, if needed)
# DATABASE_URL=sqlite:///./factory_space.db

# Logging
# LOG_LEVEL=INFO

# Smoke test runner
FACTORY_SMOKE_BASE_URL=http://127.0.0.1:8000
FACTORY_SMOKE_WS_PATH=/ws/agent
# FACTORY_SMOKE_EXTERNAL_PROVIDER=1
