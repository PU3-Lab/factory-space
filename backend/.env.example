# Application Environment
# ENVIRONMENT=development
# ENVIRONMENT=production

# LLM slot configuration
# Dev mode uses local LLM as the default slot.
FACTORY_LLM_DEFAULT_PROVIDER=local
FACTORY_LLM_DEFAULT_MODEL=llama3.1:8b
FACTORY_LLM_DEFAULT_BASE_URL=http://localhost:11434/v1
# FACTORY_LLM_DEFAULT_API_KEY=

# Optional fallback slots. Leave as none for local development without remote APIs.
FACTORY_LLM_FALLBACK1_PROVIDER=none
# FACTORY_LLM_FALLBACK1_MODEL=
# FACTORY_LLM_FALLBACK1_BASE_URL=
# FACTORY_LLM_FALLBACK1_API_KEY=

FACTORY_LLM_FALLBACK2_PROVIDER=none
# FACTORY_LLM_FALLBACK2_MODEL=
# FACTORY_LLM_FALLBACK2_BASE_URL=
# FACTORY_LLM_FALLBACK2_API_KEY=

FACTORY_LLM_TIMEOUT_MS=20000
FACTORY_LLM_MAX_OUTPUT_TOKENS=2048
FACTORY_LLM_TEMPERATURE=0.2

# Provider API keys
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# TTS voice generation
# Dev/local/test defaults to edge-tts. Production/staging defaults to ElevenLabs.
# FACTORY_TTS_ENABLED=true
# FACTORY_TTS_PROVIDER=auto
# FACTORY_TTS_STORAGE_PATH=var/tts
# FACTORY_TTS_PUBLIC_BASE_URL=/tts
# FACTORY_TTS_MAX_CHARS=600
# FACTORY_TTS_TIMEOUT_SECONDS=8
#
# ElevenLabs production example. Store the API key as a managed secret.
# ELEVENLABS_API_KEY=
# ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Voice preview tuning. Omit these to use the voice defaults.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1
# ELEVENLABS_USE_SPEAKER_BOOST=true

# Image generation (icon/texture/thumbnail assets)
# Provider: none (solid-color placeholder), openai (Images API), or local (diffusers).
# FACTORY_IMAGE_GEN_PROVIDER=none
#
# openai example (reuses OPENAI_API_KEY unless FACTORY_IMAGE_GEN_API_KEY is set):
# FACTORY_IMAGE_GEN_PROVIDER=openai
# FACTORY_IMAGE_GEN_MODEL=gpt-image-1
# FACTORY_IMAGE_GEN_API_KEY=
#
# local example (in-process diffusers; requires: uv pip install -e ".[image-local]"):
# FACTORY_IMAGE_GEN_PROVIDER=local
# FACTORY_IMAGE_GEN_MODEL=stabilityai/sdxl-turbo
# FACTORY_IMAGE_GEN_DEVICE=mps   # auto-detected (cuda > mps > cpu) when unset
#
# Storage backend: local (write to disk) or noop (discard). Path is the asset root.
# FACTORY_IMAGE_STORAGE_BACKEND=local
# FACTORY_IMAGE_STORAGE_PATH=var/materials

# Database Configuration
# Main app DB. Local development can keep this as SQLite for material/quest data.
# DATABASE_URL=sqlite:///./factory_space.db
#
# operator_guide RAG DB. RAG ingestion/search requires PostgreSQL + pgvector.
# Start local pgvector with:
# docker compose -f docker-compose.rag.yml up -d
# FACTORY_RAG_DATABASE_URL=postgresql+psycopg://factory_space:factory_space@127.0.0.1:5433/factory_space?connect_timeout=5
#
# Legacy fallback only. Prefer FACTORY_RAG_DATABASE_URL for new setups.
# FACTORY_DATABASE_URL=

# RAG embedding configuration
# FACTORY_EMBEDDING_PROVIDER=openai
# FACTORY_EMBEDDING_MODEL=text-embedding-3-small
# FACTORY_EMBEDDING_DIMENSIONS=1536
# FACTORY_EMBEDDING_API_KEY=
#
# Local embedding example for Ollama native embedding.
# Use this when you want embeddings to be generated by a local model server.
# FACTORY_EMBEDDING_PROVIDER=local
# FACTORY_EMBEDDING_MODEL=nomic-embed-text
# FACTORY_EMBEDDING_DIMENSIONS=768
# FACTORY_EMBEDDING_BASE_URL=http://localhost:11434

# Logging
# LOG_LEVEL=INFO

# Smoke test runner
FACTORY_SMOKE_BASE_URL=http://127.0.0.1:18000
FACTORY_SMOKE_WS_PATH=/ws/agent
# FACTORY_SMOKE_EXTERNAL_PROVIDER=1
